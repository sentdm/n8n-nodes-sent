{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path // empty' | { read -r f; [ -n \"$f\" ] && \"$CLAUDE_PROJECT_DIR/node_modules/.bin/prettier\" --ignore-unknown --write \"$f\"; } >/dev/null 2>&1 || true",
            "timeout": 30,
            "statusMessage": "Formatting with Prettier..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" 2>/dev/null || exit 0; out=$(\"$CLAUDE_PROJECT_DIR/node_modules/.bin/tsc\" --noEmit -p tsconfig.json 2>&1) || jq -n --arg m \"TypeScript errors (n8n-node lint is eslint-only and will not catch these):\n$out\" '{systemMessage:$m}'",
            "timeout": 120,
            "statusMessage": "Type-checking..."
          }
        ]
      }
    ]
  }
}
